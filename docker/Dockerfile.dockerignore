# ElainaBot Docker 部署 - 忽略不需要打包进镜像的文件

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 虚拟环境
venv/
.venv/
env/
.env

# 日志（运行时产生，挂载卷解决）
log/
data/
web/data/
modules/modules_enabled.json
modules/image_hosting/data/

# 本地配置（仅将示例配置打入镜像）
config/*.yaml
!config/*.example.yaml

# 本地 IDE 配置
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.github/

# 开发与测试文件
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pre-commit-config.yaml
docs/
tests/

# Docker 构建元数据（入口脚本仍需复制）
docker/compose.yml
docker/compose.build.yml
docker/Dockerfile
docker/Dockerfile.dockerignore

# 数据库文件（运行时产生）
*.db
*.sqlite
*.sqlite3
